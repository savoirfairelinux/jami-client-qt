<?xml version="1.0" encoding="UTF-8"?>
<?include Config.wxi?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="$(var.Name)"
    Language="1033"
    Version="$(fun.AutoVersion(1.0))"
    Manufacturer="$(var.Manufacturer)"
    UpgradeCode="7c45b52b-0390-4fe8-947a-3f13e82dd346"
    InstallerVersion="301"
    Compressed="yes"
    Scope="perMachine">

    <MajorUpgrade Schedule="afterInstallInitialize"
      AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes"
      CompressionLevel="high"
      MaximumUncompressedMediaSize="4" />

    <!--Disables interaction of the package with the Restart Manager.-->
    <Property Id="MSIRESTARTMANAGERCONTROL"
      Value="Disable" />

    <!--Let the in-app updater pass WIXNONUILAUNCH through an elevated install.-->
    <Property Id="WIXNONUILAUNCH"
      Secure="yes" />

    <Icon Id="icon.ico"
      SourceFile="!(bindpath.AppFiles)\jami.ico" />
    <Property Id="ARPPRODUCTICON"
      Value="icon.ico" />
    <Property Id="ARPNOMODIFY"
      Value="1" />

    <!-- It seems that QtWebEngineProcess.exe versioning requires us to force reinstall. -->
    <Property Id="REINSTALLMODE"
      Value="dms" />

    <Feature Id="ProductFeature"
      Title="Main"
      Level="1"
      AllowAbsent="no">
      <ComponentGroupRef Id="MainExecutable"
        Primary="yes" />
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="CrtFiles" />
      <ComponentRef Id="ApplicationShortcutDesktop" />
      <ComponentRef Id="ApplicationShortcutStartMenu" />
      <ComponentRef Id="RegistryEntries" />
      <ComponentRef Id="URLProtocolRegistryEntries" />
    </Feature>

    <SetProperty After="FindRelatedProducts"
      Id="FirstInstall"
      Value="true"
      Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT WIX_DOWNGRADE_DETECTED" />
    <SetProperty After="SetFirstInstall"
      Id="Upgrading"
      Value="true"
      Condition="WIX_UPGRADE_DETECTED AND NOT (REMOVE=&quot;ALL&quot;)" />
    <SetProperty After="RemoveExistingProducts"
      Id="RemovingForUpgrade"
      Sequence="execute"
      Value="true"
      Condition="(REMOVE=&quot;ALL&quot;) AND UPGRADINGPRODUCTCODE" />
    <SetProperty After="SetUpgrading"
      Id="Uninstalling"
      Value="true"
      Condition="Installed AND (REMOVE=&quot;ALL&quot;) AND NOT (WIX_UPGRADE_DETECTED OR UPGRADINGPRODUCTCODE)" />
    <SetProperty After="SetUninstalling"
      Id="Maintenance"
      Value="true"
      Condition="Installed AND NOT Upgrading AND NOT Uninstalling AND NOT UPGRADINGPRODUCTCODE" />

    <SetProperty Id="ARPINSTALLLOCATION"
      Value="[APPLICATIONFOLDER]"
      After="CostFinalize" />

    <UIRef Id="CustomUI" />
    <WixVariable Id="WixUIInfoIcon"
      Value="!(bindpath.AppFiles)\jami.ico" />
    <WixVariable Id="WixUIBannerBmp"
      Value="$(sys.SOURCEFILEDIR)top-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp"
      Value="$(sys.SOURCEFILEDIR)main-banner.bmp" />
    <WixVariable Id="override WixUISupportPerUser"
      Value="0" />

    <SetProperty Id="WixQuietExecCmdLine"
      Value="&quot;[APPLICATIONFOLDER]$(var.ExeName).exe&quot; --term"
      Before="TerminateAppProcess"
      Sequence="execute" />
    <CustomAction Id="TerminateAppProcess"
      BinaryRef="Wix4UtilCA_X64"
      DllEntry="WixQuietExec"
      Execute="immediate"
      Return="ignore" />
  </Package>

  <Fragment Id="DirectoryStructure">
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="APPLICATIONFOLDER"
        Name="$(var.Name)" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="MainExecutable"
      Directory="APPLICATIONFOLDER">
      <Component Id="cmp9CFEE34E3A162AB05264E8B756EC1DEC"
        Guid="*"
        Bitness="always64">
        <File Id="fileMain.exe"
          KeyPath="yes"
          Source="!(bindpath.AppFiles)\$(var.ExeName).exe" />
        <RemoveFile Id="OldVCRedist" Name="vc_redist.x64.exe" On="both" />
        <RemoveFile Id="OldUninstaller" Name="uninstall.exe" On="both" />
        <RemoveFile Id="OldWinSparkle" Name="WinSparkle.dll" On="both" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment Id="Payload">
    <ComponentGroup Id="AppFiles" Directory="APPLICATIONFOLDER">
      <Files Include="!(bindpath.AppFiles)\**">
        <Exclude Files="!(bindpath.AppFiles)\**\$(var.ExeName).exe" />
        <Exclude Files="!(bindpath.AppFiles)\**\*.pdb" />
        <!-- Qt can deploy an ICU stub that fails to load on older Windows. -->
        <Exclude Files="!(bindpath.AppFiles)\**\icuuc.dll" />
        <Exclude Files="!(bindpath.AppFiles)\.deploy.stamp" />
      </Files>
    </ComponentGroup>
    <ComponentGroup Id="CrtFiles" Directory="APPLICATIONFOLDER">
      <Files Include="!(bindpath.CrtFiles)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment Id="Shortcuts">
    <StandardDirectory Id="DesktopFolder">
      <Component Id="ApplicationShortcutDesktop"
        Guid="*"
        Bitness="always64"
        Condition="FirstInstall">
        <Shortcut Id="ApplicationShortcutDesktop"
          Name="$(var.Name)"
          Description="Launch $(var.Name)"
          Target="[#fileMain.exe]"
          WorkingDirectory="APPLICATIONFOLDER" />
        <RemoveFolder Id="DesktopFolder"
          On="uninstall" />
        <RegistryValue Root="HKCU"
          Key="Software\jami.net\$(var.Name)"
          Name="desktop"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcutStartMenu"
        Guid="*"
        Bitness="always64">
        <Shortcut Id="ApplicationShortcutStartMenu"
          Name="$(var.Name)"
          Description="Launch $(var.Name)"
          Target="[#fileMain.exe]"
          WorkingDirectory="APPLICATIONFOLDER" />
        <RemoveFolder Id="StartMenuFolder"
          On="uninstall" />
        <RegistryValue Root="HKCU"
          Key="Software\jami.net\$(var.Name)"
          Name="startmenu"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment Id="OtherRegistryEntries">
    <DirectoryRef Id="APPLICATIONFOLDER">
      <Component Id="RegistryEntries"
        Guid="*"
        Bitness="always64">
        <RegistryValue Root="HKCU"
          Key="Software\jami.net\$(var.AppName)"
          Name="hasRun"
          Type="integer"
          Value="0"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment Id="URLProtocol">
    <DirectoryRef Id="APPLICATIONFOLDER">
      <Component Id="URLProtocolRegistryEntries"
        Guid="*"
        Bitness="always64">
        <RegistryKey Root="HKCR"
          Key="jami"
          ForceCreateOnInstall="yes"
          ForceDeleteOnUninstall="yes">
          <RegistryValue Type="string"
            Name="URL Protocol"
            Value="" />
          <RegistryValue Type="string"
            Value="URL:jami"/>
          <RegistryKey Key="DefaultIcon">
            <RegistryValue Type="string"
              Value="[APPLICATIONFOLDER]$(var.ExeName).exe" />
          </RegistryKey>
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string"
              Value='"[APPLICATIONFOLDER]$(var.ExeName).exe" "%1"' />
          </RegistryKey>
        </RegistryKey>
      </Component>
    </DirectoryRef>
  </Fragment>

  <Fragment Id="UI">
    <UI Id="CustomUI">
      <Property Id="WixAppFolder"
        Value="WixPerMachineFolder" />

      <!--APPLICATIONFOLDER required by WixUI_Advanced, ApplicationFolderName reset APPLICATIONFOLDER path-->
      <Property Id="ApplicationFolderName"
        Value="$(var.Manufacturer)\$(var.AppName)" />
      <ui:WixUI Id="WixUI_Advanced" />

      <!--Remove User Exit Dialog-->
      <Publish Dialog="AdvancedWelcomeEulaDlg"
        Control="Cancel"
        Property="AbortInstall"
        Value="1" />
      <Publish Dialog="InstallDirDlg"
        Control="Cancel"
        Property="AbortInstall"
        Value="1" />
      <Publish Dialog="FeaturesDlg"
        Control="Cancel"
        Property="AbortInstall"
        Value="1" />
      <Publish Dialog="MaintenanceWelcomeDlg"
        Control="Cancel"
        Property="AbortInstall"
        Value="1" />
      <Publish Dialog="MaintenanceTypeDlg"
        Control="Cancel"
        Property="AbortInstall"
        Value="1" />

      <!--Launch Program If Checkbox is clicked-->
      <Publish Dialog="ExitDialog"
        Control="Finish"
        Event="DoAction"
        Value="LaunchApplication"
        Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />

      <InstallUISequence>
        <Show Dialog="override UserExit"
          OnExit="cancel"
          Condition="NOT AbortInstall = 1" />
      </InstallUISequence>
    </UI>
    <InstallExecuteSequence>
      <Custom Action="TerminateAppProcess"
        Before="InstallValidate" />
      <Custom Action="LaunchApplication_nonUI"
        After="InstallFinalize"
        Condition="WIXNONUILAUNCH" />
    </InstallExecuteSequence>

    <!--License check box text, Launch check box text (auto check)-->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
      Value="Launch $(var.Name)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
      Value="Launch $(var.Name)" />
    <!--CheckBox Default Set to One-->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX"
      Value="1" />
    <Property Id="LicenseAccepted"
      Value="1" />

    <Property Id="WixShellExecTarget"
      Value="[#fileMain.exe]" />
    <CustomAction Id="LaunchApplication"
      BinaryRef="Wix4UtilCA_X64"
      DllEntry="WixShellExec"
      Impersonate="yes" />
    <CustomAction Id="LaunchApplication_nonUI"
      BinaryRef="Wix4UtilCA_X64"
      DllEntry="WixShellExec"
      Impersonate="yes" />
    <!--License File-->
    <WixVariable Id="WixUILicenseRtf"
      Value="!(bindpath.AppFiles)\License.rtf" />
  </Fragment>

</Wix>
