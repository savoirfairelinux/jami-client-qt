<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="WixToolset.Sdk/7.0.1">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <OutputName>jami.release.x64</OutputName>
    <OutputName Condition="'$(Configuration)' == 'Beta'">jami.beta.x64</OutputName>
    <OutputType>Package</OutputType>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputPath>bin\Release\</OutputPath>
    <Cultures>en-us</Cultures>
    <DebugType>none</DebugType>
    <EnableDefaultItems>false</EnableDefaultItems>
    <AppFilesPath>$(MSBuildProjectDirectory)\..\x64\Release</AppFilesPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Product.wxs" />
    <EmbeddedResource Include="Localization.wxl" />
    <PackageReference Include="WixToolset.UI.wixext" Version="[7.0.1]" />
    <PackageReference Include="WixToolset.Util.wixext" Version="[7.0.1]" />
    <BindPath Include="$(AppFilesPath)" BindName="AppFiles" />
    <BindPath Include="$(VC_CRT_Dir)" BindName="CrtFiles" />
  </ItemGroup>

  <Target Name="CheckInstallerInputs" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(AppFilesPath)\Jami.exe') Or !Exists('$(AppFilesPath)\jami.ico') Or !Exists('$(AppFilesPath)\License.rtf')"
      Text="Build and deploy the Windows client to x64\Release before packaging." />
    <Error Condition="'$(VC_CRT_Dir)' == '' Or !Exists('$(VC_CRT_Dir)\vcruntime140.dll')"
      Text="Set VC_CRT_Dir to the x64 MSVC CRT directory containing vcruntime140.dll." />
  </Target>
</Project>