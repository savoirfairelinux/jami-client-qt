# escape=`

# Build context: the repository's extras directory.
# Windows Server Core LTSC 2025, November 2026 (amd64).
FROM mcr.microsoft.com/windows/servercore:ltsc2025@sha256:a43c2d41a3d6e940dec865731e2f5db5c3e03f705f5300ef0b5817d3e01ecfb1

SHELL ["powershell.exe", "-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

ENV CARGO_HOME=C:\cargo `
    RUSTUP_HOME=C:\rustup `
    DOTNET_ROOT=C:\tools\dotnet `
    DOTNET_CLI_TELEMETRY_OPTOUT=1 `
    CMAKE_GENERATOR="Visual Studio 18 2026" `
    CMAKE_GENERATOR_PLATFORM="x64,version=10.0.26100.0" `
    QT_DIR=C:\Qt\6.12.0\msvc2022_64 `
    VCPKG_BINARY_SOURCES=clear `
    VCPKG_DISABLE_METRICS=1

ENV PATH="C:\tools\cmake\bin;C:\tools\git\cmd;C:\tools\python;C:\cargo\bin;C:\tools\dotnet;C:\Windows\system32;C:\Windows;C:\Windows\System32\Wbem;C:\Windows\System32\WindowsPowerShell\v1.0"

# The same script sets up build hosts; see INSTALL.md.
COPY scripts/install-deps-windows.ps1 scripts/qt-6.12.0-msvc2022.lock C:\container\
RUN C:\container\install-deps-windows.ps1 -Component VisualStudio
RUN C:\container\install-deps-windows.ps1 -Component Tools -ToolsDir C:\tools
RUN C:\container\install-deps-windows.ps1 -Component Qt -QtDir $env:QT_DIR

COPY build/docker/run-msvc-build.ps1 C:\container\
ENTRYPOINT ["powershell.exe", "-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "C:\\container\\run-msvc-build.ps1"]
